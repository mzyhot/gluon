+func branchApplies(_ entry: [String: Value], _ branch: String) -> Bool {
+    let config = section(entry["config"])
+    let beta = words(config["BetaKey"] ?? config["betakey"])
+    return beta.isEmpty || beta.contains(branch) || branch == "public" && beta.contains("default")
+}
+func branchValue(_ entries: [String: Value], _ branch: String) -> Value? {
+    entries.first { $0.key.lowercased() == branch }?.value
+}
+func jsonValue(_ value: Value) -> Any {
+    switch value {
+    case .string(let string): return string
+    case .number(let number): return NSNumber(value: number)
+    case .section(let values): return values.mapValues(jsonValue)
+    }
+}
