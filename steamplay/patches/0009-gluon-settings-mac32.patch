+// Return 32 only for a positively parsed Mach-O with no 64-bit slice. An app
+// bundle is checked through CFBundleExecutable, never a DLL or Windows EXE.
+func machoBits(_ launch: URL) -> Int? {
+    var executable = launch
+    if launch.pathExtension.lowercased() == "app" {
+        guard let data = try? Data(contentsOf: launch.appendingPathComponent("Contents/Info.plist")),
+              let plist = (try? PropertyListSerialization.propertyList(from: data, format: nil)) as? [String: Any],
+              let name = plist["CFBundleExecutable"] as? String,
+              let binary = safeChild(launch.appendingPathComponent("Contents/MacOS"), name) else { return nil }
+        executable = binary
+    }
+    guard let handle = try? FileHandle(forReadingFrom: executable) else { return nil }
+    defer { try? handle.close() }
+    guard let data = try? handle.read(upToCount: 4096), data.count >= 8 else { return nil }
+    let b = [UInt8](data)
+    func u32(_ p: Int, _ little: Bool) -> UInt32 {
+        let s = little ? [0, 8, 16, 24] : [24, 16, 8, 0]
+        return (0..<4).reduce(0) { $0 | UInt32(b[p + $1]) << s[$1] }
+    }
+    let magic = u32(0, false)
+    if magic == 0xcefaedfe || magic == 0xfeedface {
+        let cpu = u32(4, magic == 0xcefaedfe)
+        guard b.count >= 28, [UInt32(7), 12, 18].contains(cpu), u32(12, magic == 0xcefaedfe) == 2 else { return nil }
+        return 32
+    }
+    if magic == 0xcffaedfe || magic == 0xfeedfacf { return 64 }
+    guard [UInt32(0xcafebabe), 0xbebafeca, 0xcafebabf, 0xbfbafeca].contains(magic) else { return nil }
+    let little = magic == 0xbebafeca || magic == 0xbfbafeca
+    let count = Int(u32(4, little)), stride = magic == 0xcafebabf || magic == 0xbfbafeca ? 32 : 20
+    guard count > 0, count <= 64, 8 + count * stride <= b.count else { return nil }
+    for n in 0..<count {
+        let cpu = u32(8 + n * stride, little)
+        if cpu & 0x01000000 != 0 { return 64 }
+        if ![UInt32(7), 12, 18].contains(cpu) { return nil }
+    }
+    return 32
+}
