+struct MacBranchFingerprint {
+    var signature: String? = nil
+    var mac64 = false
+    var required: [String: String] = [:]
+    var language: [String: String] = [:]
+    var macDepots: Set<String> = []
+    func attested(_ state: [String: Value]) -> Bool {
+        var installed: [String: String] = [:]
+        for key in ["installeddepots", "mounteddepots"] {
+            for (id, value) in section(state[key]) {
+                let nested = text(section(value)["manifest"])
+                let gid = nested.isEmpty ? text(value) : nested
+                if let previous = installed[id], previous != gid { return false }
+                if (UInt64(gid) ?? 0) != 0 { installed[id] = gid }
+            }
+        }
+        guard signature != nil, !required.isEmpty || !language.isEmpty else { return false }
+        for (id, gid) in required where gid.isEmpty || installed[id] != gid { return false }
+        for (id, gid) in language where installed[id] != nil && (gid.isEmpty || installed[id] != gid) { return false }
+        if !macDepots.isEmpty && !macDepots.contains(where: { installed[$0] != nil }) { return false }
+        return required.keys.contains { installed[$0] != nil } || language.keys.contains { installed[$0] != nil }
+    }
+}
