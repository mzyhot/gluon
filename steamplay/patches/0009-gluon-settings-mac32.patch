+func isMac32(_ app: [String: Value], _ id: UInt32, _ libraries: [URL], _ evidence: Mac32Evidence, _ depots: MacDepotVersions) -> Bool {
+    let common = section(app["common"]), systems = words(common["oslist"])
+    guard text(common["type"]).lowercased() == "game", systems.contains("macos"),
+          systems.contains("windows") else { evidence.forget(id); return false }
+    let extended = words(common["osextended"])
+    let arch64: Set<String> = ["64", "arm64", "x86_64", "amd64"]
+    if extended.contains("macos64") || extended.contains("macosapplesilicon") || !words(common["osarch"]).isDisjoint(with: arch64) {
+        evidence.forget(id); return false
+    }
+    var installations: [(URL, [String: Value])] = []
+    var branches: Set<String> = []
+    for library in libraries {
+        let state = section(manifest(library.appendingPathComponent("steamapps/appmanifest_\(id).acf"))["appstate"])
+        if let installed = safeChild(library.appendingPathComponent("steamapps/common"), text(state["installdir"])) {
+            installations.append((installed, state))
+            let selected = text(section(state["userconfig"])["betakey"]).lowercased()
+            branches.insert(selected.isEmpty || selected == "default" ? "public" : selected)
+        }
+    }
+    guard branches.count <= 1 else { evidence.forget(id); return false }
+    let branch = branches.first ?? "public"
+    let active = section(section(app["config"])["launch"]).filter { branchApplies(section($0.value), branch) }
+    let launches = active.filter { _, value in
+        let entry = section(value), config = section(entry["config"])
+        // A combined windows,macos entry naming an EXE is a legacy platform
+        // rewrite, not positive evidence of a native Mac build.
+        let executable = text(entry["executable"])
+        return words(config["oslist"]).contains("macos") && !executable.lowercased().hasSuffix(".exe") && !executable.isEmpty
+    }
+    let hasWindowsLaunch = active.values.contains { value in
+        let entry = section(value), config = section(entry["config"])
+        let os = words(config["oslist"]), executable = text(entry["executable"]).lowercased()
+        return !executable.isEmpty && (os.contains("windows") || os.isEmpty && executable.hasSuffix(".exe"))
+    }
+    guard !launches.isEmpty, hasWindowsLaunch else { evidence.forget(id); return false }
+    let version = depots.fingerprint(app, branch, launches)
+    if version.mac64 { evidence.forget(id); return false }
+    let remembered = evidence.matches(id, version.signature)
+    var all32 = true, allDeclared32 = true, installed32 = false, unknownExecutable = false
+    for value in launches.values {
+        let launch = section(value), arch = words(section(launch["config"])["osarch"])
+        if !arch.isDisjoint(with: arch64) { evidence.forget(id); return false }
+        var proof32 = arch == ["32"] // Common osarch may describe the Windows build.
+        if !proof32 { allDeclared32 = false }
+        for (installed, state) in installations {
+            if let target = safeChild(installed, text(launch["executable"])) {
+                if let native = nativeExecutable(target) {
+                    if let bits = machoBits(native) {
+                        if bits == 64 { evidence.forget(id); return false }
+                        // Bind observed bytes to the installed Mac/shared manifest
+                        // versions before assigning the current catalogue signature.
+                        if version.attested(state) { proof32 = true; installed32 = true }
+                    } else if FileManager.default.fileExists(atPath: native.path) && !proof32 { unknownExecutable = true }
+                } else if FileManager.default.fileExists(atPath: target.path) && !proof32 { unknownExecutable = true }
+            }
+        }
+        if !proof32 { all32 = false }
+    }
+    if all32 {
+        if installed32 && !allDeclared32 { evidence.remember(id, version.signature) }
+        return true
+    }
+    if unknownExecutable { evidence.forget(id); return false }
+    return remembered
+}
