+// Read only the small text manifests needed to locate installed native builds.
+// No Steam metadata, compatibility mappings or game files are ever rewritten.
+func manifest(_ path: URL) -> [String: Value] {
+    guard let data = try? Data(contentsOf: path), data.count < 8 << 20,
+          let source = String(data: data, encoding: .utf8) else { return [:] }
+    let chars = Array(source), end = chars.count
+    var at = 0
+    func token() -> String? {
+        while at < end {
+            if chars[at].isWhitespace { at += 1; continue }
+            if chars[at] == "/", at + 1 < end, chars[at + 1] == "/" {
+                while at < end && chars[at] != "\n" { at += 1 }; continue
+            }
+            break
+        }
+        guard at < end else { return nil }
+        if chars[at] == "{" || chars[at] == "}" { defer { at += 1 }; return String(chars[at]) }
+        guard chars[at] == "\"" else { at = end; return nil }
+        at += 1
+        var out = ""
+        while at < end {
+            let c = chars[at]; at += 1
+            if c == "\"" { return out }
+            if c == "\\", at < end { out.append(chars[at]); at += 1 }
+            else { out.append(c) }
+        }
+        return nil
+    }
+    func read(_ depth: Int = 0) -> [String: Value] {
+        guard depth < 32 else { return [:] }
+        var out: [String: Value] = [:]
+        while let key = token(), key != "}" {
+            guard let value = token() else { return [:] }
+            out[key.lowercased()] = value == "{" ? .section(read(depth + 1)) : .string(value)
+        }
+        return out
+    }
+    return read()
+}
