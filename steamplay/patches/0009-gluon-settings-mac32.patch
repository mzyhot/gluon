+// Preserve positive architecture evidence after Steam replaces the native Mac
+// depots with Windows depots. Evidence belongs to an exact Mac branch/version;
+// a Windows update or removal of the old Mac executable does not change it.
+struct Mac32Record: Codable {
+    let signature: String
+    var checked: Int64
+}
+struct Mac32State: Codable {
+    let version: Int
+    var apps: [String: Mac32Record]
+}
+final class Mac32Evidence {
+    private let limit = 4096
+    private let path: URL?
+    private var lockFD: Int32 = -1
+    private var changed = false
+    private var apps: [String: Mac32Record] = [:]
+    private var durable: [String: Mac32Record] = [:]
+    private var required: Set<String> = []
+    init() {
+        let environment = ProcessInfo.processInfo.environment
+        let base = environment["GLUON_HOME"].flatMap { $0.isEmpty ? nil : URL(fileURLWithPath: $0) }
+            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Library/Application Support/Gluon")
+        let directory = base.appendingPathComponent("state")
+        path = directory.appendingPathComponent("mac32-evidence.json")
+        do {
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            let fd = open(directory.appendingPathComponent("mac32-evidence.lock").path, O_CREAT | O_RDWR | O_NOFOLLOW | O_CLOEXEC, 0o600)
+            if fd >= 0 {
+                if flock(fd, LOCK_EX | LOCK_NB) == 0 { lockFD = fd }
+                else { close(fd) } // Read-only under contention; never overwrite another helper's work.
+            }
+        } catch {}
+        guard let path = path,
+              let attributes = try? FileManager.default.attributesOfItem(atPath: path.path),
+              attributes[.type] as? FileAttributeType == .typeRegular,
+              let size = attributes[.size] as? NSNumber, size.intValue <= 1 << 20,
+              let data = try? Data(contentsOf: path),
+              let state = try? JSONDecoder().decode(Mac32State.self, from: data),
+              state.version == 1, state.apps.count <= limit else { return }
+        apps = state.apps.filter { key, value in
+            UInt32(key) != nil && value.signature.count == 64 && value.signature.utf8.allSatisfy {
+                (48...57).contains($0) || (97...102).contains($0)
+            }
+        }
+        durable = apps
+    }
+    deinit { if lockFD >= 0 { flock(lockFD, LOCK_UN); close(lockFD) } }
+    func forget(_ appid: UInt32) {
+        if apps.removeValue(forKey: String(appid)) != nil { changed = true }
+    }
+    func matches(_ appid: UInt32, _ signature: String?) -> Bool {
+        guard let signature = signature, let record = apps[String(appid)], record.signature == signature else {
+            forget(appid); return false
+        }
+        return true
+    }
+    func remember(_ appid: UInt32, _ signature: String?) {
+        required.insert(String(appid))
+        guard let signature = signature else { forget(appid); return }
+        if apps[String(appid)]?.signature == signature { return }
+        apps[String(appid)] = Mac32Record(signature: signature, checked: Int64(Date().timeIntervalSince1970))
+        changed = true
+    }
+    func usable(_ appid: UInt32) -> Bool {
+        let id = String(appid)
+        return !required.contains(id) || (apps[id] != nil && apps[id]?.signature == durable[id]?.signature)
+    }
+    func save() {
+        guard changed, lockFD >= 0, let path = path else { return }
+        if apps.count > limit {
+            let retained = apps.sorted { a, b in a.value.checked > b.value.checked }.prefix(limit)
+            apps = Dictionary(uniqueKeysWithValues: retained.map { ($0.key, $0.value) })
+        }
+        guard let data = try? JSONEncoder().encode(Mac32State(version: 1, apps: apps)), data.count <= 1 << 20 else { return }
+        do {
+            try data.write(to: path, options: .atomic)
+            durable = apps
+            try? FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: path.path)
+        } catch {} // Never expose a new proof that could not be persisted before depot replacement.
+    }
+}
