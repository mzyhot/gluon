+void np_nativeplatform_refresh(void) {
+    char *js = np_nativeplatform_javascript();
+    pthread_mutex_lock(&g_catalog_lock);
+    if (!js) { free(g_mac32); g_mac32 = NULL; memset(&g_appinfo_stamp, 0, sizeof g_appinfo_stamp); }
+    free(js);
+    g_catalog_loaded = 1; // A failing helper stays conservative and does not spin.
+    g_refreshed = now_ms();
+    pthread_mutex_unlock(&g_catalog_lock);
+}
+
+static void *refresh_worker(void *unused) {
+    (void)unused;
+    np_nativeplatform_refresh();
+    pthread_mutex_lock(&g_catalog_lock);
+    g_refreshing = 0;
+    pthread_mutex_unlock(&g_catalog_lock);
+    return NULL;
+}
+
+int np_nativeplatform_is_mac32(unsigned int appid) {
+    int found = 0, refresh = 0, first;
+    char path[PATH_MAX]; struct stat current = {0};
+    appinfo_path(path, sizeof path); stat(path, &current);
+    pthread_mutex_lock(&g_catalog_lock);
+    first = !g_catalog_loaded && !g_refreshing;
+    if (first) g_refreshing = 1;
+    int stale = !same_stamp(&current, &g_appinfo_stamp);
+    if (g_catalog_loaded && (stale || now_ms() - g_refreshed > 30000) && !g_refreshing) {
+        refresh = g_refreshing = 1;
+    }
+    pthread_mutex_unlock(&g_catalog_lock);
+    if (first) {
+        np_nativeplatform_refresh();
+        pthread_mutex_lock(&g_catalog_lock); g_refreshing = 0; pthread_mutex_unlock(&g_catalog_lock);
+    }
+    if (refresh) {
+        pthread_t worker;
+        if (!pthread_create(&worker, NULL, refresh_worker, NULL)) pthread_detach(worker);
+        else {
+            pthread_mutex_lock(&g_catalog_lock); g_refreshing = 0; pthread_mutex_unlock(&g_catalog_lock);
+        }
+    }
+    pthread_mutex_lock(&g_catalog_lock);
+    // Never route using architecture evidence from an older app metadata cache.
+    const char *at = same_stamp(&current, &g_appinfo_stamp) ? g_mac32 : NULL;
+    while (at && *at) {
+        char *end;
+        unsigned long id = strtoul(at, &end, 10);
+        if (id == appid) { found = 1; break; }
+        at = *end == ',' ? end + 1 : NULL;
+    }
+    pthread_mutex_unlock(&g_catalog_lock);
+    return found;
+}
