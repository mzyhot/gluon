+func steamLibraries(_ root: URL) -> [URL] {
+    var result = [root]
+    let folders = section(manifest(root.appendingPathComponent("steamapps/libraryfolders.vdf"))["libraryfolders"])
+    for (key, value) in folders where UInt32(key) != nil {
+        let path = text(section(value)["path"])
+        if path.hasPrefix("/") { result.append(URL(fileURLWithPath: path)) }
+    }
+    return result
+}
