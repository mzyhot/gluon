+func safeChild(_ base: URL, _ relative: String) -> URL? {
+    guard !relative.isEmpty, !relative.hasPrefix("/"), !relative.contains("\\"),
+          !relative.split(separator: "/").contains("..") else { return nil }
+    let result = base.appendingPathComponent(relative).standardizedFileURL.resolvingSymlinksInPath()
+    let root = base.standardizedFileURL.resolvingSymlinksInPath().path + "/"
+    return result.path.hasPrefix(root) ? result : nil
+}
