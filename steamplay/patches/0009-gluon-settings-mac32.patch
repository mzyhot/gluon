+// Missing macos64 metadata is not evidence of a 32-bit executable. Some old
+// integrations also added macos to Windows-only entries. Require a real Mac
+// launch entry and positive Mac architecture evidence; any 64-bit evidence wins.
+func text(_ value: Value?) -> String {
+    switch value {
+    case .string(let s)?: return s
+    case .number(let n)?: return String(n)
+    default: return ""
+    }
+}
+func section(_ value: Value?) -> [String: Value] {
+    if case .section(let s)? = value { return s }
+    return [:]
+}
+func words(_ value: Value?) -> Set<String> {
+    Set(text(value).lowercased().split { $0 == "," || $0.isWhitespace }.map(String.init))
+}
+
+// Read only the small text manifests needed to locate installed native builds.
+// No Steam metadata, compatibility mappings or game files are ever rewritten.
+func manifest(_ path: URL) -> [String: Value] {
+    guard let data = try? Data(contentsOf: path), data.count < 8 << 20,
+          let source = String(data: data, encoding: .utf8) else { return [:] }
+    let chars = Array(source), end = chars.count
+    var at = 0
+    func token() -> String? {
+        while at < end {
+            if chars[at].isWhitespace { at += 1; continue }
+            if chars[at] == "/", at + 1 < end, chars[at + 1] == "/" {
+                while at < end && chars[at] != "\n" { at += 1 }; continue
+            }
+            break
+        }
+        guard at < end else { return nil }
+        if chars[at] == "{" || chars[at] == "}" { defer { at += 1 }; return String(chars[at]) }
+        guard chars[at] == "\"" else { at = end; return nil }
+        at += 1
+        var out = ""
+        while at < end {
+            let c = chars[at]; at += 1
+            if c == "\"" { return out }
+            if c == "\\", at < end { out.append(chars[at]); at += 1 }
+            else { out.append(c) }
+        }
+        return nil
+    }
+    func read(_ depth: Int = 0) -> [String: Value] {
+        guard depth < 32 else { return [:] }
+        var out: [String: Value] = [:]
+        while let key = token(), key != "}" {
+            guard let value = token() else { return [:] }
+            out[key.lowercased()] = value == "{" ? .section(read(depth + 1)) : .string(value)
+        }
+        return out
+    }
+    return read()
+}
+
+func safeChild(_ base: URL, _ relative: String) -> URL? {
+    guard !relative.isEmpty, !relative.hasPrefix("/"), !relative.contains("\\"),
+          !relative.split(separator: "/").contains("..") else { return nil }
+    let result = base.appendingPathComponent(relative).standardizedFileURL.resolvingSymlinksInPath()
+    let root = base.standardizedFileURL.resolvingSymlinksInPath().path + "/"
+    return result.path.hasPrefix(root) ? result : nil
+}
+
+// Return 32 only for a positively parsed Mach-O with no 64-bit slice. An app
+// bundle is checked through CFBundleExecutable, never a DLL or Windows EXE.
+func nativeExecutable(_ launch: URL) -> URL? {
+    var executable = launch
+    if launch.pathExtension.lowercased() == "app" {
+        guard let data = try? Data(contentsOf: launch.appendingPathComponent("Contents/Info.plist")),
+              let plist = (try? PropertyListSerialization.propertyList(from: data, format: nil)) as? [String: Any],
+              let name = plist["CFBundleExecutable"] as? String,
+              let binary = safeChild(launch.appendingPathComponent("Contents/MacOS"), name) else { return nil }
+        executable = binary
+    }
+    return executable
+}
+
+func machoBits(_ launch: URL) -> Int? {
+    guard let executable = nativeExecutable(launch) else { return nil }
+    guard let handle = try? FileHandle(forReadingFrom: executable) else { return nil }
+    defer { try? handle.close() }
+    guard let data = try? handle.read(upToCount: 4096), data.count >= 8 else { return nil }
+    let b = [UInt8](data)
+    func u32(_ p: Int, _ little: Bool) -> UInt32 {
+        let s = little ? [0, 8, 16, 24] : [24, 16, 8, 0]
+        return (0..<4).reduce(0) { $0 | UInt32(b[p + $1]) << s[$1] }
+    }
+    let magic = u32(0, false)
+    if magic == 0xcefaedfe || magic == 0xfeedface {
+        let cpu = u32(4, magic == 0xcefaedfe)
+        guard b.count >= 28, [UInt32(7), 12, 18].contains(cpu), u32(12, magic == 0xcefaedfe) == 2 else { return nil }
+        return 32
+    }
+    if magic == 0xcffaedfe || magic == 0xfeedfacf { return 64 }
+    guard [UInt32(0xcafebabe), 0xbebafeca, 0xcafebabf, 0xbfbafeca].contains(magic) else { return nil }
+    let little = magic == 0xbebafeca || magic == 0xbfbafeca
+    let count = Int(u32(4, little)), stride = magic == 0xcafebabf || magic == 0xbfbafeca ? 32 : 20
+    guard count > 0, count <= 64, 8 + count * stride <= b.count else { return nil }
+    for n in 0..<count {
+        let cpu = u32(8 + n * stride, little)
+        if cpu & 0x01000000 != 0 { return 64 }
+        if ![UInt32(7), 12, 18].contains(cpu) { return nil }
+    }
+    return 32
+}
+
+func steamLibraries(_ root: URL) -> [URL] {
+    var result = [root]
+    let folders = section(manifest(root.appendingPathComponent("steamapps/libraryfolders.vdf"))["libraryfolders"])
+    for (key, value) in folders where UInt32(key) != nil {
+        let path = text(section(value)["path"])
+        if path.hasPrefix("/") { result.append(URL(fileURLWithPath: path)) }
+    }
+    return result
+}
