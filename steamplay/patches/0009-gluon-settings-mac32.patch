+// Missing macos64 metadata is not evidence of a 32-bit executable. Some old
+// integrations also added macos to Windows-only entries. Require a real Mac
+// launch entry and positive Mac architecture evidence; any 64-bit evidence wins.
+func text(_ value: Value?) -> String {
+    switch value {
+    case .string(let s)?: return s
+    case .number(let n)?: return String(n)
+    default: return ""
+    }
+}
+func section(_ value: Value?) -> [String: Value] {
+    if case .section(let s)? = value { return s }
+    return [:]
+}
+func words(_ value: Value?) -> Set<String> {
+    Set(text(value).lowercased().split { $0 == "," || $0.isWhitespace }.map(String.init))
+}
