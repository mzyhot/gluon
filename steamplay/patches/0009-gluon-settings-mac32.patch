+final class MacDepotVersions {
+    private var references: [UInt32: [String: Value]] = [:]
+    // Shared depots can inherit their manifests and platform config from another
+    // cached app. Refuse unresolvable references rather than inventing a version.
+    func resolved(_ depot: [String: Value], _ id: String, _ seen: Set<String> = []) -> [String: Value]? {
+        guard let appid = UInt32(text(depot["depotfromapp"])), appid != 0 else { return depot }
+        let identity = "\(appid):\(id)"
+        guard !seen.contains(identity), seen.count < 16 else { return nil }
+        if references[appid] == nil { references[appid] = (try? findApp(bytes, appid)) ?? [:] }
+        guard let inheritedValue = section(references[appid]?["depots"])[id] else { return nil }
+        guard let inherited = resolved(section(inheritedValue), id, seen.union([identity])) else { return nil }
+        var result = inherited
+        for (key, value) in depot where key != "config" && key != "depotfromapp" { result[key] = value }
+        var config = section(inherited["config"])
+        for (key, value) in section(depot["config"]) { config[key] = value }
+        result["config"] = .section(config)
+        result["gluon_source_app"] = .string(String(appid))
+        return result
+    }
+    func fingerprint(_ app: [String: Value], _ branch: String, _ launches: [String: Value]) -> MacBranchFingerprint {
+        let common = section(app["common"])
+        let arch64: Set<String> = ["64", "arm64", "x86_64", "amd64"]
+        var result = MacBranchFingerprint()
+        var versions: [String: Any] = [:]
+        var complete = true
+        for (id, value) in section(app["depots"]) where UInt32(id) != nil {
+            let declared = section(value)
+            if declared.isEmpty { continue } // An empty, retired depot has no content.
+            let declaredOS = words(section(declared["config"])["oslist"])
+            if !declaredOS.isEmpty && !declaredOS.contains("macos") && !declaredOS.contains("all") { continue }
+            guard let depot = resolved(declared, id) else { complete = false; continue }
+            let config = section(depot["config"]), os = words(config["oslist"])
+            if !os.isEmpty && !os.contains("macos") && !os.contains("all") { continue }
+            if !words(config["osarch"]).isDisjoint(with: arch64) { result.mac64 = true; return result }
+            let manifest = branchValue(section(depot["manifests"]), branch)
+            let encrypted = branchValue(section(depot["encryptedmanifests"]), branch)
+            let normal = section(manifest), secret = section(encrypted)
+            let gid = text(normal["gid"]).isEmpty ? text(manifest) : text(normal["gid"])
+            let encryptedGID = text(secret["encrypted_gid"] ?? secret["encryptedgid"]).isEmpty ? text(encrypted) : text(secret["encrypted_gid"] ?? secret["encryptedgid"])
+            // Do not substitute public for a missing beta manifest: its inherited
+            // version cannot be proved from this cache.
+            guard (UInt64(gid) ?? 0) != 0 || !encryptedGID.isEmpty else { complete = false; continue }
+            if text(config["language"]).isEmpty { result.required[id] = gid }
+            else { result.language[id] = gid }
+            if os.contains("macos") { result.macDepots.insert(id) }
+            versions[id] = ["config": config.mapValues(jsonValue), "gid": gid,
+                            "encrypted_gid": encryptedGID, "source_app": text(depot["gluon_source_app"])]
+        }
+        guard complete, !versions.isEmpty else { return result }
+        let macFlags = words(common["osextended"]).filter { $0.hasPrefix("macos") }.sorted()
+        let signature: [String: Any] = ["version": 1, "branch": branch, "osarch": text(common["osarch"]),
+            "mac_flags": macFlags, "launches": launches.mapValues(jsonValue), "depots": versions]
+        guard let data = try? JSONSerialization.data(withJSONObject: signature, options: [.sortedKeys]) else { return result }
+        result.signature = SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+        return result
+    }
+}
