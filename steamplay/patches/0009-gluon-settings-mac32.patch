+void np_nativeplatform_refresh(void) {
+    char *js = np_nativeplatform_javascript();
+    pthread_mutex_lock(&g_catalog_lock);
+    if (!js) { free(g_mac32); g_mac32 = NULL; memset(&g_appinfo_stamp, 0, sizeof g_appinfo_stamp); }
+    free(js);
+    g_catalog_loaded = 1; // A failing helper stays conservative and does not spin.
+    g_refreshed = now_ms();
+    pthread_mutex_unlock(&g_catalog_lock);
