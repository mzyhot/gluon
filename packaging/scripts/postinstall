#!/bin/sh
# A system-domain package is required to integrate Steam apps outside HOME.
# Drop privileges before reading/writing any user data or invoking Gluon.
set -eu
[ "$(id -u)" -eq 0 ] || { echo 'Use the Gluon system installer.' >&2; exit 1; }
[ "${3:-/}" = / ] || { echo 'Gluon requires installation on the running system.' >&2; exit 1; }
account="$(/usr/bin/stat -f '%Su' /dev/console)"
case "$account" in ''|root|loginwindow|*[!A-Za-z0-9_.-]*) echo 'Log in to the account that owns Steam before installing Gluon.' >&2; exit 1 ;; esac
user_home="$(/usr/bin/dscl . -read "/Users/$account" NFSHomeDirectory | sed -n 's/^NFSHomeDirectory: //p')"
case "$user_home" in /*) ;; *) echo 'Cannot identify the logged-in home directory.' >&2; exit 1 ;; esac
source='/Library/Application Support/Gluon'
exec /usr/bin/sudo -H -u "$account" /usr/bin/env \
    HOME="$user_home" GLUON_HOME="$user_home/Library/Application Support/Gluon" \
    PYTHONPATH="$source/lib" /usr/bin/arch -arm64 /usr/bin/python3 -m gluon.package_install "$source"
