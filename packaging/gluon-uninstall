#!/bin/sh
# Restore managed Steam bundles and legacy settings, then remove Gluon's program files.
# Game prefixes (steamapps/compatdata), logs, backups and state are left in place.
set -e
gluon="$(cd "$(dirname "$0")/.." && pwd)"
plist="$HOME/Library/LaunchAgents/com.gluon.agent.plist"

if pgrep -x steam_osx >/dev/null; then
    echo "Quit Steam first, then run this again." >&2
    exit 1
fi
launchctl bootout "gui/$(id -u)/com.gluon.agent" 2>/dev/null || true
rm -f "$plist"
PYTHONPATH="$gluon/lib" /usr/bin/arch -arm64 /usr/bin/python3 -m gluon uninstall
rm -rf "$gluon/bin" "$gluon/lib" "$gluon/runtime" "$gluon/steamplay/payloads" "$gluon/steamplay/legacycompat"
rm -f "$gluon/steamplay/pending.json"
# The system package staging area is root-owned and may be shared by accounts.
# Its installer receipt is retained; this command removes this account's deployment.
echo "Gluon removed. Left in place: $gluon (logs, backups, state)"
