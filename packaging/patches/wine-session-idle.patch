+/* Byte 0 is Wine's lifetime lock. Byte 1 covers all user-process final cleanup;
+ * byte 2 attests this server's opt-in warm protocol. A CLI must see the same PID
+ * owning bytes 0 and 2 before it may use the idle lock or idle-only control socket. */
+static int open_gluon_session_lock( pid_t *owner )
+{
+    struct flock fl;
+    pid_t pid;
+    int fd;
+
+    server_dir = create_server_dir( 0 );
+    if (!server_dir) return -1;
+    fd = create_server_lock();
+    fl.l_type = F_WRLCK;
+    fl.l_whence = SEEK_SET;
+    fl.l_start = 0;
+    fl.l_len = 1;
+    if (fcntl( fd, F_GETLK, &fl ) == -1 || fl.l_type != F_WRLCK || !(pid = fl.l_pid)) goto unsupported;
