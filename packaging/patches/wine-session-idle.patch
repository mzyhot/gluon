+
+/* Byte 0 is Wine's lifetime lock. Byte 1 covers all user-process final cleanup;
+ * byte 2 attests this server's opt-in warm protocol. A CLI must see the same PID
+ * owning bytes 0 and 2 before it may use the idle lock or idle-only control socket. */
+static int open_gluon_session_lock( pid_t *owner )
+{
+    struct flock fl;
+    pid_t pid;
+    int fd;
+
+    server_dir = create_server_dir( 0 );
+    if (!server_dir) return -1;
+    fd = create_server_lock();
+    fl.l_type = F_WRLCK;
+    fl.l_whence = SEEK_SET;
+    fl.l_start = 0;
+    fl.l_len = 1;
+    if (fcntl( fd, F_GETLK, &fl ) == -1 || fl.l_type != F_WRLCK || !(pid = fl.l_pid)) goto unsupported;
+    fl.l_type = F_WRLCK;
+    fl.l_start = 2;
+    if (fcntl( fd, F_GETLK, &fl ) == -1 || fl.l_type != F_WRLCK || fl.l_pid != pid) goto unsupported;
+    *owner = pid;
+    return fd;
+
+unsupported:
+    close( fd );
+    return -1;
+}
+
+/* Read-only absence proof for retiring an expired runtime fingerprint. A
+ * leftover or lockless server socket is conservatively treated as running. */
+int check_server_running(void)
+{
+    struct flock fl;
+    struct stat st;
+    int fd, ret;
+
+    server_dir = create_server_dir( 0 );
+    if (!server_dir) return 3;
+    fd = create_server_lock();
+    fl.l_type = F_WRLCK;
+    fl.l_whence = SEEK_SET;
+    fl.l_start = 0;
+    fl.l_len = 1;
+    ret = fcntl( fd, F_GETLK, &fl );
+    close( fd );
+    if (ret == -1) return 1;
+    if (fl.l_type == F_WRLCK) return 0;
+    return lstat( server_socket_name, &st ) == -1 && errno == ENOENT ? 3 : 0;
+}
+
+/* Exit 3 means an ordinary/cold server, or no server; callers retain -w. */
+int wait_for_gluon_idle(void)
+{
+    struct flock fl;
+    pid_t owner;
+    int fd, ret;
+
+    if ((fd = open_gluon_session_lock( &owner )) == -1) return 3;
+    fl.l_type = F_WRLCK;
+    fl.l_whence = SEEK_SET;
+    fl.l_start = 1;
+    fl.l_len = 1;
+    do ret = fcntl( fd, F_SETLKW, &fl ); while (ret == -1 && errno == EINTR);
+    close( fd );
+    return ret == -1 ? 1 : 0;
+}
+
+/* Native local control keeps idle-only teardown inside the server event loop.
+ * There is no query-then-kill race and no PID signal that can hit a reused PID. */
+static void gluon_control_poll_event( struct fd *fd, int event )
+{
+    struct sockaddr_un address;
+    socklen_t size = sizeof(address);
+    char command, result;
+
+    if (!(event & POLLIN)) return;
+    if (recvfrom( get_unix_fd( fd ), &command, 1, 0, (struct sockaddr *)&address, &size ) != 1) return;
+    if (command != 'K') return;
+    result = '0' + shutdown_gluon_idle_session();
+    sendto( get_unix_fd( fd ), &result, 1, 0, (struct sockaddr *)&address, size );
+}
+
+static const struct fd_ops gluon_control_fd_ops =
+{
+    NULL,
+    gluon_control_poll_event,
+    NULL, NULL, NULL, NULL, NULL
+};
+
+static void open_gluon_control_socket(void)
+{
+    struct sockaddr_un address;
+    struct master_socket *control;
+    int fd;
+
+    memset( &address, 0, sizeof(address) );
+    address.sun_family = AF_UNIX;
+#ifdef HAVE_STRUCT_SOCKADDR_UN_SUN_LEN
+    address.sun_len = sizeof(address);
+#endif
+    strcpy( address.sun_path, "gluon-control" );
+    unlink( address.sun_path );
+    if ((fd = socket( AF_UNIX, SOCK_DGRAM, 0 )) == -1) fatal_error( "Gluon control socket: %s\n", strerror( errno ));
+    if (bind( fd, (struct sockaddr *)&address, sizeof(address) ) == -1)
+        fatal_error( "Gluon control bind: %s\n", strerror( errno ));
+    chmod( address.sun_path, 0600 );
+    fcntl( fd, F_SETFL, O_NONBLOCK );
+    if (!(control = alloc_object( &master_socket_ops )) ||
+        !(control->fd = create_anonymous_fd( &gluon_control_fd_ops, fd, &control->obj, 0 )))
+        fatal_error( "out of memory\n" );
+    set_fd_events( control->fd, POLLIN );
+    make_object_permanent( &control->obj );
+}
+
+/* Return 0 only when the server accepted idle-only teardown; 2 is busy, 3 is
+ * unsupported/absent. Callers still use bounded -w to confirm actual shutdown. */
+int request_gluon_idle_shutdown(void)
+{
+    struct sockaddr_un address;
+    struct pollfd pollfd;
+    char directory[] = ".gluon-idle-client-XXXXXX", command = 'K', result = '1';
+    pid_t owner;
+    int lock_fd, fd = -1, status = 1;
+
+    if ((lock_fd = open_gluon_session_lock( &owner )) == -1) return 3;
+    close( lock_fd );
+    if (!mkdtemp( directory )) return 1;
+    memset( &address, 0, sizeof(address) );
+    address.sun_family = AF_UNIX;
+#ifdef HAVE_STRUCT_SOCKADDR_UN_SUN_LEN
+    address.sun_len = sizeof(address);
+#endif
+    snprintf( address.sun_path, sizeof(address.sun_path), "%s/client", directory );
+    if ((fd = socket( AF_UNIX, SOCK_DGRAM, 0 )) == -1) goto done;
+    if (bind( fd, (struct sockaddr *)&address, sizeof(address) ) == -1) goto done;
+    strcpy( address.sun_path, "gluon-control" );
+    if (connect( fd, (struct sockaddr *)&address, sizeof(address) ) == -1) goto done;
+    if (write( fd, &command, 1 ) != 1) goto done;
+    pollfd.fd = fd;
+    pollfd.events = POLLIN;
+    if (poll( &pollfd, 1, 1000 ) == 1 && read( fd, &result, 1 ) == 1 && (result == '0' || result == '2'))
+        status = result - '0';
+done:
+    if (fd != -1) close( fd );
+    snprintf( address.sun_path, sizeof(address.sun_path), "%s/client", directory );
+    unlink( address.sun_path );
+    rmdir( directory );
+    return status;
+}
+
+void set_gluon_user_active( int active )
+{
+    struct flock fl;
+    int ret;
+
+    if (!gluon_session_mode) return;
+    if (gluon_lock_fd == -1) fatal_error( "Gluon warm sessions require server file locking\n" );
+    fl.l_type = active ? F_WRLCK : F_UNLCK;
+    fl.l_whence = SEEK_SET;
+    fl.l_start = 1;
+    fl.l_len = 1;
+    do ret = fcntl( gluon_lock_fd, F_SETLKW, &fl ); while (ret == -1 && errno == EINTR);
+    if (ret == -1) fatal_error( "Gluon user-process lock: %s\n", strerror( errno ));
 }
 
