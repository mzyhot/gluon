+static void open_gluon_control_socket(void)
+{
+    struct sockaddr_un address;
+    struct master_socket *control;
+    int fd;
+
+    memset( &address, 0, sizeof(address) );
+    address.sun_family = AF_UNIX;
+#ifdef HAVE_STRUCT_SOCKADDR_UN_SUN_LEN
+    address.sun_len = sizeof(address);
+#endif
+    strcpy( address.sun_path, "gluon-control" );
+    unlink( address.sun_path );
+    if ((fd = socket( AF_UNIX, SOCK_DGRAM, 0 )) == -1) fatal_error( "Gluon control socket: %s\n", strerror( errno ));
+    if (bind( fd, (struct sockaddr *)&address, sizeof(address) ) == -1)
+        fatal_error( "Gluon control bind: %s\n", strerror( errno ));
+    chmod( address.sun_path, 0600 );
+    fcntl( fd, F_SETFL, O_NONBLOCK );
+    if (!(control = alloc_object( &master_socket_ops )) ||
+        !(control->fd = create_anonymous_fd( &gluon_control_fd_ops, fd, &control->obj, 0 )))
+        fatal_error( "out of memory\n" );
+    set_fd_events( control->fd, POLLIN );
+    make_object_permanent( &control->obj );
+}
+
+/* Return 0 only when the server accepted idle-only teardown; 2 is busy, 3 is
+ * unsupported/absent. Callers still use bounded -w to confirm actual shutdown. */
+static int request_gluon_session_control( char command )
+{
+    struct sockaddr_un address;
+    struct pollfd pollfd;
+    char directory[] = ".gluon-idle-client-XXXXXX", result = '1';
+    pid_t owner;
+    int lock_fd, fd = -1, status = 1;
+
+    if ((lock_fd = open_gluon_session_lock( &owner )) == -1) return 3;
+    close( lock_fd );
+    if (!mkdtemp( directory )) return 1;
+    memset( &address, 0, sizeof(address) );
+    address.sun_family = AF_UNIX;
+#ifdef HAVE_STRUCT_SOCKADDR_UN_SUN_LEN
+    address.sun_len = sizeof(address);
+#endif
+    snprintf( address.sun_path, sizeof(address.sun_path), "%s/client", directory );
+    if ((fd = socket( AF_UNIX, SOCK_DGRAM, 0 )) == -1) goto done;
+    if (bind( fd, (struct sockaddr *)&address, sizeof(address) ) == -1) goto done;
+    strcpy( address.sun_path, "gluon-control" );
+    if (connect( fd, (struct sockaddr *)&address, sizeof(address) ) == -1) goto done;
+    if (write( fd, &command, 1 ) != 1) goto done;
+    pollfd.fd = fd;
+    pollfd.events = POLLIN;
+    if (poll( &pollfd, 1, 1000 ) == 1 && read( fd, &result, 1 ) == 1 && (result == '0' || result == '2'))
+        status = result - '0';
+done:
+    if (fd != -1) close( fd );
+    snprintf( address.sun_path, sizeof(address.sun_path), "%s/client", directory );
+    unlink( address.sun_path );
+    rmdir( directory );
+    return status;
+}
