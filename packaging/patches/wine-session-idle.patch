+    fl.l_start = 2;
+    if (fcntl( fd, F_GETLK, &fl ) == -1 || fl.l_type != F_WRLCK || fl.l_pid != pid) goto unsupported;
+    *owner = pid;
+    return fd;
+
+unsupported:
+    close( fd );
+    return -1;
