+/* A server started before a failed game command must still expire on time. */
+void init_gluon_session_timeout(void)
+{
+    if (gluon_session_mode && !user_processes && !shutdown_timeout)
+        shutdown_timeout = add_timeout_user( master_socket_timeout, server_shutdown_timeout, NULL );
+}
+
+/* Native control runs in the ordinary single-threaded server event loop.
+ * Never terminate user processes based on a client's earlier idle observation. */
+int shutdown_gluon_idle_session(void)
+{
+    if (!gluon_session_mode || user_processes || shutdown_stage) return 2;
+    shutdown_master_socket();
+    return 0;
+}
