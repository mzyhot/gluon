+    if (!(event & POLLIN)) return;
+    if (recvfrom( get_unix_fd( fd ), &command, 1, 0, (struct sockaddr *)&address, &size ) != 1) return;
+    if (command != 'K' && command != 'S' && command != 'C') return;
+    result = '0' + (command == 'K' ? shutdown_gluon_idle_session() :
+                    command == 'S' ? seal_gluon_session() : cold_gluon_session());
+    sendto( get_unix_fd( fd ), &result, 1, 0, (struct sockaddr *)&address, size );
