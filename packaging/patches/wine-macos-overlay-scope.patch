+/* Gluon: Steam's overlay, passed as GLUON_OVERLAY_INSERT, belongs only in game
+ * processes. Injected into Wine's own programs or the server, it can end them
+ * when Steam's pipe closes and leave the rest of the prefix behind. A game is
+ * any program outside the prefix's Windows directory; a bare built-in name
+ * such as "wineboot" is not one. */
+static BOOL is_game_image( const char *program, const char *image_path )
+{
+    const char *path = program;
+    char *lower, *p;
+    BOOL game;
+
+    if (image_path && ((image_path[0] && image_path[1] == ':') || !strncmp( image_path, "\\??\\", 4 )))
+        path = image_path;
+    if (!path || (!strchr( path, '/' ) && !strchr( path, '\\' ))) return FALSE;
+    if (!(lower = strdup( path ))) return FALSE;
+    for (p = lower; *p; p++) if (*p >= 'A' && *p <= 'Z') *p += 'a' - 'A';
+    game = !strstr( lower, ":\\windows\\" ) && !strstr( lower, "/drive_c/windows/" );
+    free( lower );
+    return game;
+}
 
+static void scope_steam_overlay( const char *program, const char *image_path )
+{
+    const char *overlay = getenv( "GLUON_OVERLAY_INSERT" );
 
+    if (!overlay) return;
+    if (*overlay && is_game_image( program, image_path )) setenv( "DYLD_INSERT_LIBRARIES", overlay, 1 );
+    else unsetenv( "DYLD_INSERT_LIBRARIES" );
+}
+
 static void preloader_exec( char **argv, const char *image_path )
 {
+    scope_steam_overlay( argv[2], image_path );
+
