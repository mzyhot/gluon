+/* Gluon: a loader started from an app bundle (Contents/MacOS) keeps every
+ * process of its session in that bundle, so macOS uses the bundle's name,
+ * category and launch activation for all of them. */
+static char *bundled_wineloader(void)
+{
+    char path[PATH_MAX];
+    uint32_t size = sizeof(path);
+
+    if (_NSGetExecutablePath( path, &size ) || !strstr( path, ".app/Contents/MacOS/" )) return NULL;
+    return strdup( path );
 }
 
+/* Gluon: LaunchServices starts a game's app bundle in "/"; the launcher passes
+ * the game's working directory instead. Only the first process uses it, and
+ * Windows programs it starts inherit their directory as usual. */
+static void enter_game_directory(void)
+{
+    const char *dir = getenv( "GLUON_GAME_CWD" );
+
+    if (!dir) return;
+    if (chdir( dir )) fprintf( stderr, "wine: cannot enter the game directory %s\n", dir );
+    unsetenv( "GLUON_GAME_CWD" );
+}
