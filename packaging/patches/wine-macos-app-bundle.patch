+    /* Gluon: the first activation request can arrive before a window is ordered
+       in. Check readiness promptly without spending activation attempts on an
+       empty instance. Once visible, request at most three bundle activations,
+       stopping when a window is active on the current Space. The monotonic
+       deadline bounds hidden-window polling; a user switching to an unrelated
+       app cancels the handoff. GLUON_FOCUS=0 turns this fallback off. */
+    - (BOOL) gluonWindowShown:(BOOL*)onActiveSpace
+    {
+        BOOL shown = FALSE;
+
+        *onActiveSpace = FALSE;
+        for (NSWindow* window in [NSApp windows])
+        {
+            if (![window isKindOfClass:[WineWindow class]] || ![window isVisible] || [window isMiniaturized])
+                continue;
+            shown = TRUE;
+            if ([window isOnActiveSpace]) *onActiveSpace = TRUE;
+        }
+        return shown;
+    }
+
+    - (BOOL) gluonFocusStillOwnedBy:(NSRunningApplication*)owner
+    {
+        NSRunningApplication *front = [[NSWorkspace sharedWorkspace] frontmostApplication];
+        NSRunningApplication *current = [NSRunningApplication currentApplication];
+        NSString *identifier = [front bundleIdentifier];
