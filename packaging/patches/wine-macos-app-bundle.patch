--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -2169,6 +2169,41 @@
         [NSApp yieldActivationToApplication:otherApp];
         [otherApp activateFromApplication:[NSRunningApplication currentApplication]
                                   options:0];
+    }
+
+    /* Gluon: Steam, not another Wine app, is usually active when a game window
+       first appears, and it does not yield. A game started from its own app
+       bundle asks LaunchServices once to activate that bundle, then repeats the
+       request so the bundle's other Wine processes can yield as above.
+       GLUON_FOCUS=0 turns this off. */
+    - (void) activateBundleOnceIfStillInactive
+    {
+        static BOOL attempted;
+        NSURL *bundleURL = [[NSBundle mainBundle] bundleURL];
+        const char *focus = getenv("GLUON_FOCUS");
+
+        if (attempted || (focus && !strcmp(focus, "0"))) return;
+        if (![[bundleURL pathExtension] isEqualToString:@"app"]) return;
+        attempted = YES;
+
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+            NSWorkspaceOpenConfiguration *configuration;
+
+            if ([NSApp isActive]) return;
+            configuration = [NSWorkspaceOpenConfiguration configuration];
+            configuration.activates = YES;
+            configuration.createsNewApplicationInstance = NO;
+            configuration.addsToRecentItems = NO;
+            [[NSWorkspace sharedWorkspace] openApplicationAtURL:bundleURL
+                                                  configuration:configuration
+                                              completionHandler:^(NSRunningApplication *app, NSError *error){
+                (void)app;
+                (void)error;
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    if (![NSApp isActive]) [self tryToActivateIgnoringOtherApps:YES];
+                });
+            }];
+        });
     }
 
     - (void) tryToActivateIgnoringOtherApps:(BOOL)ignore
@@ -2206,6 +2241,7 @@
 
         /* This is racy. See the note in otherWineAppWillActivate:. */
         [NSApp activate];
+        [self activateBundleOnceIfStillInactive];
      }
 
