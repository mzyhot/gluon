+
+/* Gluon: a loader started from an app bundle (Contents/MacOS) keeps every
+ * process of its session in that bundle, so macOS uses the bundle's name,
+ * category and launch activation for all of them. */
+static char *bundled_wineloader(void)
+{
+    char path[PATH_MAX];
+    uint32_t size = sizeof(path);
+
+    if (_NSGetExecutablePath( path, &size ) || !strstr( path, ".app/Contents/MacOS/" )) return NULL;
+    return strdup( path );
 }
 
 static void replace_wineloader_path_with_link(char **wineloader_path, const char *image_path)
@@ -686,8 +699,17 @@
      * When the preloader is not being used, WINEDLLPATH needs to be set correctly for
      * the loader to find ntdll.so, so don't even attempt this unless WINEDLLPATH is set.
      */
-    if (getenv("WINEDLLPATH"))
-        replace_wineloader_path_with_link( &(argv[1]), image_path );
+    {
+        char *bundled = bundled_wineloader();
+
+        if (bundled)
+        {
+            free( argv[1] );
+            argv[1] = bundled;
+        }
+        else if (getenv("WINEDLLPATH"))
+            replace_wineloader_path_with_link( &(argv[1]), image_path );
+    }
