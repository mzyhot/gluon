+    /* Gluon: quitting a game's app (Cmd-Q, its menu or the Dock) ends its whole
+       Steam session, as Steam's Stop does: Gluon's launcher host stops every
+       process of the game. A game that ignores WM_QUERYENDSESSION, or the
+       game's other processes, would otherwise keep running. */
+    - (BOOL) stopGluonSession
+    {
+        const char *value = getenv("GLUON_HOST_PID");
+        char path[PROC_PIDPATHINFO_MAXSIZE];
+        const char *name;
+        char *end;
+        long pid;
+
+        if (!value || !*value) return FALSE;
+        pid = strtol(value, &end, 10);
+        if (*end || pid <= 1) return FALSE;
+        /* Never signal a reused PID: it must still be Gluon's launcher host. */
+        if (proc_pidpath((pid_t)pid, path, sizeof(path)) <= 0) return FALSE;
+        name = strrchr(path, '/');
+        if (!name || strcmp(name + 1, "gluon-launcher-host")) return FALSE;
+        return !kill((pid_t)pid, SIGTERM);
+    }
