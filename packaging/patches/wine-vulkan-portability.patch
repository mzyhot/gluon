+static VkResult get_native_portability_subset_features( struct vulkan_physical_device *physical_device,
+        struct mempool *pool, struct native_portability_subset_features **portability )
+{
+    struct vulkan_instance *instance = physical_device->instance;
+    PFN_vkGetPhysicalDeviceFeatures2 get_features;
+    VkPhysicalDeviceFeatures2 features = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+    VkExtensionProperties *properties = NULL;
+    uint32_t count = 0, i, attempt;
+    VkResult res;
+
+    *portability = NULL;
+    /* The extension set can change between the count and data calls. Bound
+     * enumeration retries and fail rather than create a non-compliant device. */
+    for (attempt = 0; attempt < 3; attempt++)
+    {
+        free( properties );
+        properties = NULL;
+        if ((res = instance->p_vkEnumerateDeviceExtensionProperties( physical_device->host.physical_device,
+                                                                    NULL, &count, NULL ))) goto done;
+        if (!count) goto done;
+        if (count > SIZE_MAX / sizeof(*properties) || !(properties = calloc( count, sizeof(*properties) )))
+        {
+            res = VK_ERROR_OUT_OF_HOST_MEMORY;
+            goto done;
+        }
+        res = instance->p_vkEnumerateDeviceExtensionProperties( physical_device->host.physical_device,
+                                                               NULL, &count, properties );
+        if (res != VK_INCOMPLETE) break;
+    }
+    if (res == VK_INCOMPLETE)
+    {
+        ERR( "Host device extension enumeration remained incomplete\n" );
+        res = VK_ERROR_INITIALIZATION_FAILED;
+    }
+    if (res) goto done;
+    for (i = 0; i < count; i++)
+        if (!strcmp( properties[i].extensionName, native_portability_subset_extension )) break;
+    if (i == count) goto done;
+
+    get_features = instance->p_vkGetPhysicalDeviceFeatures2;
+    if (!get_features) get_features = (PFN_vkGetPhysicalDeviceFeatures2)instance->p_vkGetPhysicalDeviceFeatures2KHR;
+    if (!get_features)
+    {
+        ERR( "Host portability subset requires a features2 query\n" );
+        res = VK_ERROR_INITIALIZATION_FAILED;
+        goto done;
+    }
+    if (!(*portability = mem_alloc( pool, sizeof(**portability) )))
+    {
+        res = VK_ERROR_OUT_OF_HOST_MEMORY;
+        goto done;
+    }
+    memset( *portability, 0, sizeof(**portability) );
+    (*portability)->sType = NATIVE_PORTABILITY_SUBSET_FEATURES_STYPE;
+    features.pNext = *portability;
+    /* These host-returned bits are the supported subset. Never force a feature
+     * unavailable in Metal, or modify the caller's requested core features. */
+    get_features( physical_device->host.physical_device, &features );
+    TRACE( "Native portability subset: triangleFans %u, pointPolygons %u, tessellationIsolines %u, tessellationPointMode %u\n",
+           (*portability)->triangleFans, (*portability)->pointPolygons,
+           (*portability)->tessellationIsolines, (*portability)->tessellationPointMode );
+
+done:
+    free( properties );
+    return res;
+}
