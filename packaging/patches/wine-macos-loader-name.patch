+/* Gluon: libraries inserted with DYLD_INSERT_LIBRARIES, such as Steam's overlay,
+ * can load AppKit before the loader's main() rewrites the bundle name in memory,
+ * and the application menu then keeps the default name. Write a copy of the
+ * loader whose embedded Info.plist already carries the program's name, using
+ * the same rewrite as apple_override_bundle_name. */
+static BOOL write_named_loader(const char *wineloader_path, const char *linkpath, const char *exe_name)
 {
+    static const char prefix[] = "<key>CFBundleName</key>\n    <string>";
+    static const char suffix[] = "</string>";
+    static const char padding[] = "<!-- bundle name padding -->";
+    const size_t prefix_len = strlen(prefix), suffix_len = strlen(suffix), padding_len = strlen(padding);
+    size_t name_len = strlen(exe_name), size = 0, max_len, copy_len, remaining, pos;
+    char *data = NULL, *name, *end, *temp = NULL;
     struct stat st;
+    ssize_t count;
+    BOOL ret = FALSE;
+    int fd;
+
+    if ((fd = open(wineloader_path, O_RDONLY)) == -1) return FALSE;
+    if (!fstat(fd, &st) && st.st_size > 0 && st.st_size <= 64 * 1024 * 1024) size = st.st_size;
+    if (size && (data = malloc(size)))
+    {
+        for (pos = 0; pos < size; pos += count)
+            if ((count = read(fd, data + pos, size - pos)) <= 0) break;
+        if (pos < size) size = 0;
+    }
+    close(fd);
+    fd = -1;
+    if (!data || !size || !name_len || !loader_copy_allowed(data, size)) goto out;
+
+    if (!(name = memmem(data, size, prefix, prefix_len))) goto out;
+    name += prefix_len;
+    remaining = data + size - name;
+    if (!(end = memmem(name, remaining, suffix, suffix_len))) goto out;
+    max_len = end - name;
+    remaining -= max_len + suffix_len;
+    if (padding_len <= remaining && !memcmp(end + suffix_len, padding, padding_len))
+        max_len += padding_len;
+    copy_len = name_len < max_len ? name_len : max_len;
+    memcpy(name, exe_name, copy_len);
+    memcpy(name + copy_len, suffix, suffix_len);
+    memset(name + copy_len + suffix_len, ' ', max_len - copy_len);
+
+    if (asprintf(&temp, "%s.XXXXXX", linkpath) == -1)
+    {
+        temp = NULL;
+        goto out;
+    }
+    if ((fd = mkstemp(temp)) == -1) goto out;
+    for (pos = 0; pos < size; pos += count)
+        if ((count = write(fd, data + pos, size - pos)) <= 0) goto out;
+    if (fchmod(fd, 0755)) goto out;
