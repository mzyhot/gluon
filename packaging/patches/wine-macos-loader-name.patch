+/* Editing a signed loader would invalidate its signature and macOS would kill
+ * the program, so only copy a thin, unsigned 64-bit Mach-O loader. */
+static BOOL loader_copy_allowed(const char *data, size_t size)
+{
+    unsigned int magic, ncmds, cmd, cmdsize, i;
+    size_t pos = 32;  /* sizeof(struct mach_header_64) */
+
+    if (size < pos) return FALSE;
+    memcpy(&magic, data, sizeof(magic));
+    memcpy(&ncmds, data + 16, sizeof(ncmds));
+    if (magic != 0xfeedfacf) return FALSE;  /* MH_MAGIC_64 */
+    for (i = 0; i < ncmds; i++)
+    {
+        if (size - pos < 8) return FALSE;
+        memcpy(&cmd, data + pos, sizeof(cmd));
+        memcpy(&cmdsize, data + pos + 4, sizeof(cmdsize));
+        if (cmd == 0x1d) return FALSE;  /* LC_CODE_SIGNATURE */
+        if (cmdsize < 8 || cmdsize > size - pos) return FALSE;
+        pos += cmdsize;
+    }
+    return TRUE;
+}
