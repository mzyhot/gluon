+/***********************************************************************
+ *              gluon_compat_as_core_request
+ *
+ * Gluon: GLUON_GL_COMPAT_AS_CORE=1 opts a game into mapping desktop
+ * 3.0-4.1 requests that macOS cannot honour onto its core profile.
+ */
+static BOOL gluon_compat_as_core_request(int major, int minor, int profile, int flags)
+{
+    const char *value = getenv("GLUON_GL_COMPAT_AS_CORE");
+
+    if (!value || strcmp(value, "1")) return FALSE;
+    /* Profiles do not apply below 3.2, and macdrv rejects every 3.0/3.1 request. */
+    if (major == 3 && (minor == 0 || minor == 1)) return TRUE;
+    if (!((major == 3 && (minor == 2 || minor == 3)) || (major == 4 && (minor == 0 || minor == 1))))
+        return FALSE;
+    return profile != WGL_CONTEXT_CORE_PROFILE_BIT_ARB || !(flags & WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB);
 }
 
