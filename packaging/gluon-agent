#!/bin/sh
# Background helper started by launchd (com.gluon.agent). Each run makes sure every
# Windows game in the Steam library without a runnable Mac build (none, or 32-bit only)
# is installable and routed through Gluon.
# Steam's files are only edited while it is closed. When Steam refreshes managed
# entries while running, the helper offers to restart it and repairs them then.
here="$(cd "$(dirname "$0")/.." && pwd)"
PYTHONPATH="$here/lib" exec /usr/bin/arch -arm64 /usr/bin/python3 -m gluon sync --log
